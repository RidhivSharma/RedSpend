rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/settings/{document=**} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/categories/{categoryId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/budgets/{budgetId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/transactions/{transactionId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isTransactionValid(request.resource.data);
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isTransactionValid(data) {
      return data.type in ['income', 'expense']
        && data.amount is number
        && data.amount > 0
        && data.categoryId is string
        && data.categoryId.size() > 0
        && data.categoryName is string
        && data.categoryName.size() > 0
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && (!('isDemo' in data) || data.isDemo is bool);
    }
  }
}
